# Mẫu biến môi trường cho triển khai production bằng Docker Compose — xem docs/TRIEN_KHAI.md.
# Copy thành ".env.production" (đã gitignore, KHÔNG commit file thật) rồi điền giá trị thật:
#   cp .env.production.example .env.production
# Chạy: docker compose --env-file .env.production up -d --build

# Mật khẩu root MySQL (cũng dùng làm user kết nối của app — xem docker-compose.yml DB_USER=root) —
# đặt 1 mật khẩu mạnh, KHÔNG dùng giá trị mẫu này.
DB_PASSWORD=doi_mat_khau_nay_truoc_khi_chay_thuc_te
DB_NAME=internship_management

# Domain/URL thật của frontend — CORS chỉ cho phép ĐÚNG origin này (xem server/app.js). Phải khớp
# domain thật sau khi cấu hình Nginx/HTTPS (docs/TRIEN_KHAI.md), ví dụ https://thuctap.truongdemo.edu.vn
CLIENT_URL=https://doi-domain-nay.example.com

# BẮT BUỘC tối thiểu 32 ký tự ngẫu nhiên — server từ chối khởi động nếu thiếu/ngắn hơn khi
# NODE_ENV=production (xem server/config/productionChecks.js). Tạo nhanh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi_gia_tri_nay_bang_chuoi_ngau_nhien_toi_thieu_32_ky_tu
JWT_EXPIRES_IN=1d

APP_TIMEZONE=Asia/Ho_Chi_Minh

# KHÔNG set 'true' trong production — server sẽ từ chối khởi động nếu bật (lộ stack trace/thông tin
# nội bộ, xem server/config/productionChecks.js).
DEBUG_ERRORS=false

# Gửi email thật — xem README Mục 16I để biết cách lấy App Password Gmail/Mailtrap.
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hệ thống quản lý thực tập <no-reply@example.com>"

# Job nhắc việc tự động (chạy 8:00 hằng ngày) — xem README Mục 16J.
REMINDER_JOB_ENABLED=false

# Số hop reverse proxy phía TRƯỚC app (xem docs/TRIEN_KHAI.md mục Nginx) — để trống nếu không đặt
# Nginx/reverse proxy nào trước app (ví dụ test compose trên máy local, truy cập thẳng cổng 5000).
TRUST_PROXY_HOPS=1
