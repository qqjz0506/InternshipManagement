{
  "name": "internship-management",
  "private": true,
  "version": "1.0.0",
  "description": "Đồ án tốt nghiệp — Hệ thống Quản lý Thực tập Tốt nghiệp (root orchestration, không chứa dependency riêng)",
  "scripts": {
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "server:start": "npm run start --prefix server",
    "test:e2e": "playwright test",
    "docker:up": "docker compose --env-file .env.production up -d --build",
    "docker:down": "docker compose --env-file .env.production down",
    "docker:logs": "docker compose --env-file .env.production logs -f app"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
