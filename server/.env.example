PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=internship_management
DB_USER=root
DB_PASSWORD=

# Database RIÊNG cho automated test (NODE_ENV=test) — tách khỏi DB_NAME để `npm test` không đụng dữ
# liệu dev đang dùng để code/demo thủ công. Tạo bằng: npm run test:setup
DB_NAME_TEST=internship_management_test

CLIENT_URL=http://localhost:5173

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Múi giờ dùng cho "hôm nay"/"tương lai" ở business logic (log_date, submitted_at, published_at, tên
# file export...) — xem server/utils/dateTime.js. Mặc định Asia/Ho_Chi_Minh nếu không set.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Tùy chọn — CHỈ bật khi cần debug thủ công trên máy dev (Phase 7A F-03). Để trống/không set =
# response lỗi không bao giờ lộ message gốc của lỗi không lường trước hay stack trace. KHÔNG set
# true trong môi trường demo/production.
DEBUG_ERRORS=
