PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=internship_management
DB_USER=root
DB_PASSWORD=

# Database RIÊNG cho automated test (NODE_ENV=test) — tách khỏi DB_NAME để `npm test` không đụng dữ
# liệu dev đang dùng để code/demo thủ công. Tạo bằng: npm run test:setup
DB_NAME_TEST=internship_management_test

CLIENT_URL=http://localhost:5173

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Múi giờ dùng cho "hôm nay"/"tương lai" ở business logic (log_date, submitted_at, published_at, tên
# file export...) — xem server/utils/dateTime.js. Mặc định Asia/Ho_Chi_Minh nếu không set.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Tùy chọn — CHỈ bật khi cần debug thủ công trên máy dev (Phase 7A F-03). Để trống/không set =
# response lỗi không bao giờ lộ message gốc của lỗi không lường trước hay stack trace. KHÔNG set
# true trong môi trường demo/production.
DEBUG_ERRORS=

# Gửi email (thông báo tự động + quên mật khẩu) — xem server/services/mailService.js và README Mục
# 16I để biết cách tạo App Password Gmail hoặc tài khoản Mailtrap miễn phí cho demo. MAIL_ENABLED
# khác 'true' (hoặc NODE_ENV=test) -> KHÔNG gửi SMTP thật, chỉ ghi vào server/logs/mail-outbox.log.
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hệ thống quản lý thực tập <no-reply@example.com>"

# Job nhắc việc tự động (server/jobs/reminderJob.js) — chạy mỗi ngày 8:00 theo APP_TIMEZONE, gửi
# notify (kèm email nếu MAIL_ENABLED=true) cho Student/Lecturer/Company Mentor có việc quá hạn/sắp
# đến hạn. Phải = 'true' tường minh mới chạy (an toàn theo mặc định), và luôn tắt khi NODE_ENV=test.
# Chạy tay 1 lần: npm run reminders:run (không cần set biến này).
REMINDER_JOB_ENABLED=false

# Chỉ cần khi chạy `npm run admin:create` (bootstrap production không seed — xem
# server/scripts/createAdmin.js, docs/TRIEN_KHAI.md) — KHÔNG cần cho dev bình thường (dev dùng
# server/db/seed.sql đã có sẵn tài khoản demo, xem README Mục 13).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_FULL_NAME=
